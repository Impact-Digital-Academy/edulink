generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SubjectGroup {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  subjects  Subject[]

  @@map("subject_groups")
}

model Subject {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  name      String
  groupId   Int          @map("group_id")
  group     SubjectGroup @relation(fields: [groupId], references: [id])
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")

  @@index([groupId])
  @@map("subjects")
}

model Level {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("levels")
}

model Curriculum {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("curricula")
}

model Qualification {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      String
  rank      Int
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("qualifications")
}

model JobType {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("job_types")
}

model RoleType {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("role_types")
}

model State {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String @unique
  lgas Lga[]

  @@map("states")
}

model Lga {
  id      Int    @id @default(autoincrement())
  stateId Int    @map("state_id")
  state   State  @relation(fields: [stateId], references: [id])
  name    String

  @@unique([stateId, name])
  @@index([stateId])
  @@map("lgas")
}