# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=

# Redis (job queue)
REDIS_URL=

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Providers (test mode in local and staging)
EMAIL_API_KEY=
SMS_API_KEY=
FCM_SERVICE_ACCOUNT_PATH=

# Storage (private bucket for documents)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
