# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3100

# Database (PostgreSQL)
DATABASE_URL=

# Redis (job queue, later)
REDIS_URL=

# Authentication. Each secret must be random and at least 32 characters.
JWT_ACCESS_SECRET=
AUTH_CODE_SECRET=

# Email. Use console in development (codes print in the server log).
# Production requires brevo.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=EduLink
EMAIL_FROM_ADDRESS=
BREVO_API_KEY=

# Push notifications (later)
FCM_SERVICE_ACCOUNT_PATH=

# Storage (private bucket for documents, later)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
